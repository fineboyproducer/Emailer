# Copy this file to .env locally, and set the same values in your hosting
# provider's dashboard (Render → your service → Environment) for
# production. .env itself is gitignored and never gets deployed.

# ---- Database (Supabase Postgres) ----
# From Supabase: Project Settings → Database → Connection string → URI.
# Use the "Transaction pooler" connection string on Render (port 6543) -
# it handles many short-lived connections better than the direct
# connection. Example shape:
# postgresql://postgres.xxxxxxxxxxxx:[PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=

# ---- Email (Resend) ----
RESEND_API_KEY=re_your_api_key_here
FROM_EMAIL=you@yourdomain.com
FROM_NAME=Your Name

# Signing secret for the Resend webhook (Resend dashboard → Webhooks →
# your endpoint → Signing Secret). Starts with whsec_. Required for
# opens/clicks/deliveries/bounces/complaints to be recorded - see README.
RESEND_WEBHOOK_SECRET=whsec_your_signing_secret_here

# ---- App ----
# The password you'll use to log in to your app (choose your own).
ADMIN_PASSWORD=change-this-password

# A random long string used to sign login sessions. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-random-string

# Full public URL of your deployed app (used to build unsubscribe links,
# and is where you'll point the Resend webhook at /api/webhooks/resend).
# For local testing this can stay as-is.
APP_URL=http://localhost:3000

# Port the server listens on (most hosts set this for you automatically).
PORT=3000

# ---- Live masterclass registration + reminders ----
# Long random string. The scheduler (GitHub Actions) sends this in the x-cron-secret
# header to trigger reminder runs. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=change-this-to-another-random-string

# All optional - these are the defaults:
# LIVE_EVENT_NAME=How To Stop Wasting Money Promoting Your Songs
# LIVE_WEEKDAY=5                 # 0 = Sunday ... 5 = Friday
# LIVE_HOUR_WAT=20               # 8:00 PM West Africa Time
# LIVE_DURATION_MIN=60
# LIVE_PAGE_URL=https://fineboyproducer.com.ng/live/
# LIVE_SEGMENT_NAME=Live Registrants
# LIVE_EMAIL_KINDS=confirm,24h,1h,live     # drop any you don't want, e.g. confirm,1h
# LIVE_FROM_NAME=                # defaults to FROM_NAME
# LIVE_ALLOWED_ORIGINS=https://fineboyproducer.com.ng,https://www.fineboyproducer.com.ng
# LIVE_SYNC_FROM_SITE_TABLE=true # only does anything if this database also holds the live page's event_registrations table
